{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mapping-generator",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-c",
        "import os,http.server,socketserver;p=int(os.environ.get('PORT','8123'));socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('',p),http.server.SimpleHTTPRequestHandler).serve_forever()"
      ],
      "port": 8123,
      "autoPort": true
    }
  ]
}
